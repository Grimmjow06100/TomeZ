{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "baseUrl": ".",
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "script/buildJson.js",
    "app/api/Manga/route.ts",
    ".next\\dev/types/**/*.ts",
    ".next\\dev/types/**/*.ts"
, "lib/constant.js"  ],
  "exclude": [
    "node_modules"
  ],
  "noImplicitReturns": true,
  "noUsedParameters": true,
  "noUnusedLocals": true,
  "strict": true
}
